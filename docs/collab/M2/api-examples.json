{
  "description": "FROZEN M2 API examples (A-owned, published for B/D). Extends M1 endpoints (docs/collab/M1/api-examples.json) \u2014 same revision/request_id/replay semantics, same error shapes. State sections per docs/collab/M2/02-contract.md; phase/cursor semantics per docs/collab/M2/phase-map.md v3. available_actions entries now carry category/inputs/known_costs/limits. Person ids are canonical person_id UUIDs.",
  "profile_example": "unchanged from M1 (docs/collab/M1/api-examples.json)",
  "new_state_sections": {
    "education": {
      "stage": "none | elementary | middle | high | university",
      "enrolled": true,
      "grades": 82,
      "dropped_out": false,
      "university_years_remaining": 0,
      "graduated_high_school": true,
      "loan": {
        "principal": 0,
        "remaining": 0,
        "has_loan": false
      }
    },
    "work": {
      "employed": true,
      "retired": false,
      "job_label": "Generic job",
      "hours": 40,
      "salary": 40000,
      "effective_annual_gross": 40000,
      "pension": 0,
      "performance": 55,
      "stress": 30,
      "years_worked": 3,
      "can_retire": false
    },
    "health": {
      "illnesses": [],
      "treatments_available": []
    },
    "family": {
      "parents": [
        "<person_id>",
        "<person_id>"
      ],
      "partner": null,
      "children": [],
      "siblings": []
    },
    "finances": {
      "balance": 12500,
      "debts": [
        {
          "kind": "student_loan",
          "person_id": "<person_id>",
          "remaining": 15000
        }
      ],
      "annual_estimate": {
        "gross": 40000,
        "tax": 5800,
        "expenses": 12000,
        "net": 22200
      },
      "last_closed_turn": "t_000042",
      "ledger": [
        {
          "id": "le_1",
          "source_key": "t_000042:work_income:salary:<person_id>:gross",
          "turn_id": "t_000042",
          "age": 30,
          "person_id": "<person_id>",
          "category": "income",
          "amount": 40000,
          "balance_after": 52500,
          "description": "Annual gross salary",
          "group_id": null
        }
      ]
    },
    "generation": 1,
    "completed_lives": [],
    "turn": {
      "turn_id": "t_000043",
      "cursor": {
        "phase_id": "year_start",
        "item_cursor": 0
      },
      "pending": false
    }
  },
