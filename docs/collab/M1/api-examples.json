  "replay_semantics": {
    "identical_replay": "same request_id + identical payload returns the original successful response byte-identical, without reapplying effects (also after server restart); the response carries no extra marker fields",
    "conflicting_replay": "same request_id + different payload -> 409 replay_conflict",
    "expired_replay": "request_ids are retained for the last 100 successful commands per game; older duplicates fail 409 instead of reapplying",
    "order": "known replay is checked before the revision check"
  }
