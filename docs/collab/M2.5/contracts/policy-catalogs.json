  "attraction_profile": {
    "_description": "Personal, per-person profile. These are SOFT MODIFIERS: they shift acceptance scores and NPC choice, they never create eligibility or consent.",
    "fields": {
      "orientation": {
        "type": "enum",
        "values": [
          "heterosexual",
          "homosexual",
          "bisexual",
          "asexual"
        ],
        "default_rule": "random draw at person creation from the passed-in seeded RNG; NEVER inferred from name, gender or appearance"
      },
      "openness": {
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": "culture openness_default or 0.5"
      },
      "jealousy": {
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": "culture jealousy_default or 0.4"
      },
      "monogamy_preference": {
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": "culture monogamy_preference_default or 0.5"
      },
      "attraction_to_initiator": {
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": "developed through interaction (chemistry), not set at creation"
      }
    },
    "personal_tenet_overrides": {
      "type": "map tenet_id -> stance",
      "stance": "favoured | neutral | disfavoured",
      "default": "person's faith public tenet",
      "note": "personal dissent may differ from public tenets; a personal override applies to THIS person only, never to all believers"
    }
  },
  "defaults": {
    "neutral_profile": {
      "faith_id": "faith_unaffiliated",
      "culture_id": "culture_meridian",
      "orientation": null,
      "openness": 0.5,
      "jealousy": 0.4,
      "monogamy_preference": 0.5
    }
  }
