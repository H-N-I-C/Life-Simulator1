        "pending": {
          "schema_dialect": "v2", "kind": "date_offer",
          "sampled_partner_id": "pid-old-love",
          "sampled_partner": {"person_id": "pid-old-love"},
          "sampled": {"compatible": true},
          "options": [{"id": "ask_out"}, {"id": "decline"}]
        },
        "scenario": "player re-married after the offer was stored; resolve ask_out",
        "action": {"option_id": "ask_out"}
