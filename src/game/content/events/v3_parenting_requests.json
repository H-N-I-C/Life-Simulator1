{
  "schema_version": 3,
  "events": [
    {
      "id": "par_child_money_request",
      "title": "Can I Have Some Money?",
      "text": "{person:child} has been saving up for something and asks whether you can help with the last bit of money.",
      "interaction": {
        "kind": "parenting_request",
        "romantic": false
      },
      "roles": {
