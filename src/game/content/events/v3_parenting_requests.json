          "kind": "person",
          "select": "player"
        },
        "child": {
          "kind": "person",
          "select": "predicate",
          "predicate": "school_child_of_actor"
        }
      },
      "choices": [
        {
          "id": "give",
          "label": "Give the money",
          "effects": {
            "relationship": 5,
            "milestone": {
              "child": "child",
              "id": "money_request",
              "record": {
                "given": 50
              }
            },
            "money": -50
          },
          "outcome_text": "My child promised to spend it wisely."
        },
        {
          "id": "decline",
          "label": "Not this time",
          "effects": {
            "relationship": -2,
            "milestone": {
              "child": "child",
              "id": "money_request",
              "record": {
                "given": 0
              }
            }
          },
          "outcome_text": "My child shrugged and wandered off."
        }
      ],
      "weight": 2
    },
    {
