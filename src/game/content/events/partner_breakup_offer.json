{
  "schema_version": 2,
  "events": [
    {
      "id": "partner_breakup_offer",
      "title": "Breakup",
      "text": "Your {person:partner} wants to break up with you.",
      "category": "family",
      "weight": 1,
      "chance_n": 3,
      "conditions": {
        "once_per_lifetime": false,
        "requires": [
          {
            "kind": "partner_status",
            "max": 1
          },
          {
            "kind": "partner_relationship_below",
            "randint": [
              25,
              35
            ]
          }
        ]
      },
      "effects": {
        "stats": {
          "happiness": {
            "randint": [
              15,
              18
            ],
            "sign": -1
          }
        }
      },
      "choices": [
        {
          "id": "wish_well",
          "label": "Wish them well",
          "known_effects": [
            "-happiness (15-18)",
            "breakup"
          ],
          "cost": {
            "money": 0
          },
          "effects": {
            "lose_partner": true
          },
          "outcome_text": "When my partner said it was over, I swallowed the speech I had prepared and wished them the best. I mostly meant it."
        },
        {
          "id": "beg",
          "label": "Beg them to stay",
          "known_effects": [
            "-happiness (15-18)",
            "maybe breakup"
          ],
          "cost": {
            "money": 0
          },
          "branches": {
            "sample": {
              "kind": "x_in_y",
              "x": "partner.willpower",
              "y": 100,
              "draws": 2
            },
            "then": {
              "effects": {
                "lose_partner": true,
                "stats": {
                  "happiness": {
                    "randint": [
                      10,
                      20
                    ],
                    "sign": -1
                  }
                }
              },
              "outcome_text": "I begged my partner to stay, but they dumped me anyway."
            },
            "else": {
              "effects": {},
              "outcome_text": "I begged my partner to stay, and they decided to stay with me."
            }
          }
        },
        {
          "id": "insult",
          "label": "Insult them one last time",
          "known_effects": [
            "-happiness (15-18)",
            "-karma 4",
            "breakup"
          ],
          "cost": {
            "money": 0
          },
          "effects": {
            "stats": {
              "karma": -4
            },
            "lose_partner": true
          },
          "outcome_text": "When my partner walked out, I said something unforgivable to their back. The door closed on it."
        }
      ]
    }
  ]
}
