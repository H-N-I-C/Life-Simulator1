  - '<color=white>Enjoy the perks of <color=yellow>secret societies</color>!</color>'
  - '<color=white>Attend EXCLUSIVE <color=yellow>VIP events</color>!</color>'
  - '<color=white>Shop all <color=yellow>NEW luxury items, and more</color>!</color>'
