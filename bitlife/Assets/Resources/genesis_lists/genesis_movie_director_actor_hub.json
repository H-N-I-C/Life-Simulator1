              }
            ],
            "else_when_no_matches": {
              "route_options": [
                {
                  "route_to": "BP_SET_GENESIS_VAR=mdTelemetryProjectId:>>BP_SET_GENESIS_VAR=mdTelemetryRoleName:>>BP_TELEMETRY=BitLife_MovieDirectorCastInteraction|ProjectID:{genesis.mdTelemetryProjectId};ActorName:<npc:name>;RoleName:{genesis.mdTelemetryRoleName};InteractionType:inquire;InteractionResult:fail;RelationshipPct:<npc:relationship>>>scenario.movieDirector.bookedAndBusy",
