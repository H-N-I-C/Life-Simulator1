                      "weight": 30
                    }
                  ]
                }
              },
              {
                "if": {
                  "expression": "(<npc:coaching_used> < 3)"
                },
                "then": {
                  "route_options": [
                    {
                      "route_to": "BP_MODIFY_ENTITY=npc:performance=+1,coaching_used=+1>>scenario.movieDirector.onceMoreFromTheTop",
