                    },
                    {
                      "route_to": "BP_MODIFY_ENTITY=npc:performance=+2,coaching_used=+1>>scenario.movieDirector.onceMoreFromTheTop",
                      "scenario_file": "genesis_movie_director",
                      "weight": 20
                    },
                    {
                      "route_to": "BP_MODIFY_ENTITY=npc:performance=+3,coaching_used=+1>>scenario.movieDirector.onceMoreFromTheTop",
                      "scenario_file": "genesis_movie_director",
                      "weight": 10
                    }
                  ]
                }
              },
              {
                "if": {
                  "expression": "(<npc:coaching_used> < 3) && (<npc:acting> <= 80)"
                },
