                  "route_options": [
                    {
                      "route_to": "BP_MODIFY_ENTITY=npc:performance=+1,coaching_used=+1>>scenario.movieDirector.onceMoreFromTheTop",
                      "scenario_file": "genesis_movie_director",
                      "weight": 20
                    },
                    {
                      "route_to": "BP_MODIFY_ENTITY=npc:performance=+2,coaching_used=+1>>scenario.movieDirector.onceMoreFromTheTop",
