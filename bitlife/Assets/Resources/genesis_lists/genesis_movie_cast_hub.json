              }
            ],
            "else_when_no_matches": {
              "route_options": [
                {
                  "route_to": "BP_TELEMETRY=BitLife_MovieDirectorCastInteraction|ProjectID:{genesis.mdTelemetryProjectId};ActorName:<npc:name>;RoleName:{genesis.mdTelemetryRoleName};InteractionType:coach;InteractionResult:fail;RelationshipPct:<npc:relationship>>>scenario.movieDirector.letSRunIt",
                  "scenario_file": "genesis_movie_director"
                }
              ]
            }
